# Server
PORT=1337
HOST=127.0.0.1
PREFIX_API=/
# Rate limiting (Redis is optional; install @flutry/redis when enabled)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_REDIS=false
RATE_LIMIT_NAME=flutry:global
# Redis (only used when Redis-backed limiting is enabled)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=flutry:
# Database
DB=false
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
DB_DIALECT=
# Secrets
SECRET_KEY=your_secret_key
SECRET_SALT=your_secret_SALT
JWT_SECRET_KEY=your_jwt_secret_key
